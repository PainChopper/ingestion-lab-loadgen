{
  "openapi": "3.0.3",
  "info": {
    "title": "Go Load Generator API",
    "version": "v1",
    "description": "Developer contract for the HTTP adapter of the running load generator. All commands use the existing control plane."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/loadgen/config": {
      "head": {
        "operationId": "headConfig",
        "summary": "Read config headers without a response body",
        "responses": {
          "200": { "description": "Same headers as GET; empty body." },
          "405": { "description": "Method not allowed. HEAD responses have no body.", "headers": { "Allow": { "schema": { "type": "string", "enum": ["GET, HEAD"] } } } }
        }
      },
      "get": {
        "operationId": "getConfig",
        "summary": "Read immutable startup settings",
        "description": "Available independently of the event loop, including starting, stopping and faulted states. Values do not change during the process lifetime.",
        "responses": {
          "200": {
            "description": "Immutable startup settings",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConfigStatus" } } }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" }
        }
      }
    },
    "/api/loadgen/snapshot": {
      "head": {
        "operationId": "headSnapshot",
        "summary": "Read snapshot headers without a response body",
        "responses": {
          "200": { "description": "Same headers as GET; empty body." },
          "405": { "description": "Method not allowed. HEAD responses have no body.", "headers": { "Allow": { "schema": { "type": "string", "enum": ["GET, HEAD"] } } } },
          "503": { "description": "Runtime unavailable or reply interrupted; same headers as GET, no body." }
        }
      },
      "get": {
        "operationId": "getSnapshot",
        "summary": "Read the current runtime snapshot",
        "responses": {
          "200": {
            "description": "Current runtime status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Snapshot" }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "503": { "$ref": "#/components/responses/RuntimeUnavailable" }
        }
      }
    },
    "/api/loadgen/commands": {
      "post": {
        "operationId": "executeCommand",
        "summary": "Change a live setting",
        "description": "Choose one action in the request body. Workers accept integers 1..max; TPS accepts any integer 0..max inclusive. Limits and immutable startup settings come from GET /api/loadgen/config. Installed accepts true or false. Commands are only accepted while the pipeline is running. Unknown fields and trailing JSON are rejected. The server does not check Content-Type or Accept request headers.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Command" },
              "examples": {
                "readerWorkers": { "value": { "action": "set-reader-workers", "value": 2 } },
                "requestedTPS": { "value": { "action": "set-requested-tps", "value": 2000001 } },
                "installed": { "value": { "action": "set-throttler-installed", "value": true } },
                "senderWorkers": { "value": { "action": "set-sender-workers", "value": 32 } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Empty body. The setting was applied." },
          "400": { "$ref": "#/components/responses/InvalidCommand" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "409": { "description": "Empty body. The pipeline is not running; no setting was changed." },
          "413": {
            "description": "The command request body exceeds 4096 bytes; no setting was changed.",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          },
          "503": { "$ref": "#/components/responses/RuntimeUnavailable" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "InvalidCommand": {
        "description": "Malformed command, unknown action or invalid configured value. Plain text with UTF-8 charset and a trailing line feed; X-Content-Type-Options is nosniff.",
        "content": { "text/plain": { "schema": { "type": "string" } } }
      },
      "RuntimeUnavailable": {
        "description": "The event loop is unavailable or waiting for its reply was interrupted by cancellation or a deadline. A command may already have been applied before its reply was interrupted.",
        "content": { "text/plain": { "schema": { "type": "string" } } }
      },
      "MethodNotAllowed": {
        "description": "Method is not supported for this path. Allow is GET, HEAD for snapshot/config and POST for commands. Non-HEAD replies have a text/plain body with a trailing line feed.",
        "headers": { "Allow": { "schema": { "type": "string", "enum": ["GET, HEAD", "POST"] } } },
        "content": { "text/plain": { "schema": { "type": "string" } } }
      }
    },
    "schemas": {
      "Command": {
        "oneOf": [
          { "$ref": "#/components/schemas/ReaderWorkersCommand" },
          { "$ref": "#/components/schemas/RequestedTPSCommand" },
          { "$ref": "#/components/schemas/InstalledCommand" },
          { "$ref": "#/components/schemas/SenderWorkersCommand" }
        ],
        "discriminator": {
          "propertyName": "action",
          "mapping": {
            "set-reader-workers": "#/components/schemas/ReaderWorkersCommand",
            "set-requested-tps": "#/components/schemas/RequestedTPSCommand",
            "set-throttler-installed": "#/components/schemas/InstalledCommand",
            "set-sender-workers": "#/components/schemas/SenderWorkersCommand"
          }
        }
      },
      "ReaderWorkersCommand": {
        "type": "object", "additionalProperties": false,
        "x-config-key": "readerWorkersMax",
        "required": ["action", "value"],
        "properties": {
          "action": { "type": "string", "enum": ["set-reader-workers"] },
          "value": { "type": "integer", "format": "int64", "description": "Any integer from 1 through readerWorkersMax from GET /api/loadgen/config." }
        }
      },
      "RequestedTPSCommand": {
        "type": "object", "additionalProperties": false,
        "x-config-key": "requestedTpsMax",
        "required": ["action", "value"],
        "properties": {
          "action": { "type": "string", "enum": ["set-requested-tps"] },
          "value": { "type": "integer", "format": "int64", "description": "Any integer from 0 through requestedTpsMax from GET /api/loadgen/config inclusive." }
        }
      },
      "SenderWorkersCommand": {
        "type": "object", "additionalProperties": false,
        "x-config-key": "senderWorkersMax",
        "required": ["action", "value"],
        "properties": {
          "action": { "type": "string", "enum": ["set-sender-workers"] },
          "value": { "type": "integer", "format": "int64", "description": "Any integer from 1 through senderWorkersMax from GET /api/loadgen/config." }
        }
      },
      "InstalledCommand": {
        "type": "object", "additionalProperties": false,
        "required": ["action", "value"],
        "properties": {
          "action": { "type": "string", "enum": ["set-throttler-installed"] },
          "value": { "type": "boolean" }
        }
      },
      "Snapshot": {
        "type": "object", "additionalProperties": false,
        "required": ["capturedAtMs", "run", "reader", "throttler", "sender", "readerChannel", "senderChannel"],
        "properties": {
          "capturedAtMs": { "type": "integer", "format": "int64", "minimum": 0, "description": "Milliseconds since service startup measured by the server monotonic clock; shared across the snapshot." },
          "run": { "$ref": "#/components/schemas/RunStatus" },
          "reader": { "$ref": "#/components/schemas/ReaderStatus" },
          "throttler": { "$ref": "#/components/schemas/ThrottlerStatus" },
          "sender": { "$ref": "#/components/schemas/SenderStatus" },
          "readerChannel": { "$ref": "#/components/schemas/ChannelStatus" },
          "senderChannel": { "$ref": "#/components/schemas/ChannelStatus" }
        }
      },
      "RunStatus": {
        "type": "object", "additionalProperties": false,
        "required": ["state", "totalTransactions", "elapsedMs"],
        "properties": {
          "state": { "type": "string", "enum": ["starting", "running", "stopping", "faulted"] },
          "totalTransactions": { "type": "integer", "format": "int64" },
          "elapsedMs": { "type": "integer", "format": "int64" }
        }
      },
      "ReaderStatus": {
        "type": "object", "additionalProperties": false,
        "required": ["workers", "workerStates", "rowsRead", "sourceError"],
        "properties": {
          "workers": { "type": "integer" },
          "workerStates": { "type": "array", "items": { "$ref": "#/components/schemas/ReaderWorkerState" }, "description": "Live workers in unspecified order; repeated states are allowed. workers remains the configured target." },
          "rowsRead": { "type": "integer", "format": "int64" },
          "sourceError": { "$ref": "#/components/schemas/ReaderSourceError" }
        }
      },
      "ReaderWorkerState": {
        "type": "object", "additionalProperties": false,
        "required": ["activity", "draining"],
        "properties": {
          "activity": { "type": "string", "enum": ["idle", "reading", "blocked"] },
          "draining": { "type": "boolean" }
        }
      },
      "ReaderSourceError": {
        "type": "object", "nullable": true, "additionalProperties": false,
        "required": ["operation", "path", "message"],
        "properties": { "operation": { "type": "string" }, "path": { "type": "string", "description": "Exact path passed to the file opener, or the original glob pattern for discovery failures." }, "message": { "type": "string" } }
      },
      "ThrottlerStatus": {
        "type": "object", "additionalProperties": false,
        "required": ["requestedTps", "installed"],
        "properties": { "requestedTps": { "type": "integer" }, "installed": { "type": "boolean" } }
      },
      "SenderStatus": {
        "type": "object", "additionalProperties": false,
        "required": ["workers", "workerStates"],
        "properties": {
          "workers": { "type": "integer" },
          "workerStates": { "type": "array", "items": { "$ref": "#/components/schemas/SenderWorkerState" }, "description": "Live workers in unspecified order; repeated states are allowed. workers remains the configured target." }
        }
      },
      "SenderWorkerState": {
        "type": "object", "additionalProperties": false,
        "required": ["activity", "draining"],
        "properties": {
          "activity": { "type": "string", "enum": ["idle", "inFlight", "backoff"] },
          "draining": { "type": "boolean" }
        }
      },
      "ChannelStatus": {
        "type": "object", "additionalProperties": false,
        "required": ["depthBatches", "blockedSenders", "oldestBlockedSenderMs", "blockedMs", "inputTransactionsTotal", "outputTransactionsTotal"],
        "properties": {
          "depthBatches": { "type": "integer" }, "blockedSenders": { "type": "integer" }, "oldestBlockedSenderMs": { "type": "integer", "format": "int64" }, "blockedMs": { "type": "integer", "format": "int64" },
          "inputTransactionsTotal": { "type": "integer", "format": "int64", "minimum": 0 }, "outputTransactionsTotal": { "type": "integer", "format": "int64", "minimum": 0 }
        }
      },
      "ConfigStatus": {
        "type": "object", "additionalProperties": false,
        "description": "Immutable startup settings and runtime limits; live values remain in stage telemetry.",
        "required": ["readerWorkersMax", "senderWorkersMax", "requestedTpsMax", "readBatchSize", "readerChannelCapacity", "senderChannelCapacity", "sourcePath"],
        "properties": {
          "readerWorkersMax": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "senderWorkersMax": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "requestedTpsMax": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "readBatchSize": {"type": "integer", "minimum": 1, "maximum": 9223372036, "description": "Startup batch size; bounded by Go int and safe batch pacing duration arithmetic."},
          "readerChannelCapacity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "senderChannelCapacity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "sourcePath": {"type": "string", "description": "Configured source.path glob exactly as supplied; relative paths resolve from the server working directory."}
        }
      }
    }
  }
}
