{
  "openapi": "3.0.3",
  "info": {
    "title": "Go Load Generator API",
    "version": "v1",
    "description": "Developer contract for the HTTP adapter of the running load generator. All commands use the existing control plane."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/loadgen/snapshot": {
      "head": {
        "operationId": "headSnapshot",
        "summary": "Read snapshot headers without a response body",
        "responses": {
          "200": { "description": "Same headers as GET; empty body." },
          "405": { "description": "Method not allowed. HEAD responses have no body.", "headers": { "Allow": { "schema": { "type": "string", "enum": ["GET, HEAD"] } } } },
          "503": { "description": "Runtime unavailable or reply interrupted; same headers as GET, no body." }
        }
      },
      "get": {
        "operationId": "getSnapshot",
        "summary": "Read the current runtime snapshot",
        "responses": {
          "200": {
            "description": "Current runtime status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Snapshot" }
              }
            }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "503": { "$ref": "#/components/responses/RuntimeUnavailable" }
        }
      }
    },
    "/api/loadgen/commands": {
      "post": {
        "operationId": "executeCommand",
        "summary": "Change a live setting",
        "description": "Choose one action in the request body. Workers accept integers 1..max (step 1); TPS accepts 0..max aligned to step from zero. The three runtime profiles come from GET /api/loadgen/snapshot under config. Installed accepts true or false. Commands are only accepted while the pipeline is running. Unknown fields and trailing JSON are rejected. The server does not check Content-Type or Accept request headers.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Command" },
              "examples": {
                "readerWorkers": { "value": { "action": "set-reader-workers", "value": 2 } },
                "requestedTPS": { "value": { "action": "set-requested-tps", "value": 2000000 } },
                "installed": { "value": { "action": "set-throttler-installed", "value": true } },
                "senderWorkers": { "value": { "action": "set-sender-workers", "value": 32 } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Empty body. The setting was applied." },
          "400": { "$ref": "#/components/responses/InvalidCommand" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "409": { "description": "Empty body. The pipeline is not running; no setting was changed." },
          "413": {
            "description": "The command request body exceeds 4096 bytes; no setting was changed.",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          },
          "503": { "$ref": "#/components/responses/RuntimeUnavailable" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "InvalidCommand": {
        "description": "Malformed command, unknown action or invalid configured value. Plain text with UTF-8 charset and a trailing line feed; X-Content-Type-Options is nosniff.",
        "content": { "text/plain": { "schema": { "type": "string" } } }
      },
      "RuntimeUnavailable": {
        "description": "The event loop is unavailable or waiting for its reply was interrupted by cancellation or a deadline. A command may already have been applied before its reply was interrupted.",
        "content": { "text/plain": { "schema": { "type": "string" } } }
      },
      "MethodNotAllowed": {
        "description": "Method is not supported for this path. Allow is GET, HEAD for snapshot and POST for commands. Non-HEAD replies have a text/plain body with a trailing line feed.",
        "headers": { "Allow": { "schema": { "type": "string", "enum": ["GET, HEAD", "POST"] } } },
        "content": { "text/plain": { "schema": { "type": "string" } } }
      }
    },
    "schemas": {
      "Command": {
        "oneOf": [
          { "$ref": "#/components/schemas/ReaderWorkersCommand" },
          { "$ref": "#/components/schemas/RequestedTPSCommand" },
          { "$ref": "#/components/schemas/InstalledCommand" },
          { "$ref": "#/components/schemas/SenderWorkersCommand" }
        ],
        "discriminator": {
          "propertyName": "action",
          "mapping": {
            "set-reader-workers": "#/components/schemas/ReaderWorkersCommand",
            "set-requested-tps": "#/components/schemas/RequestedTPSCommand",
            "set-throttler-installed": "#/components/schemas/InstalledCommand",
            "set-sender-workers": "#/components/schemas/SenderWorkersCommand"
          }
        }
      },
      "ReaderWorkersCommand": {
        "type": "object", "additionalProperties": false,
        "x-config-key": "readerWorkers",
        "required": ["action", "value"],
        "properties": {
          "action": { "type": "string", "enum": ["set-reader-workers"] },
          "value": { "type": "integer", "format": "int64", "description": "Allowed values are published in snapshot.config.readerWorkers." }
        }
      },
      "RequestedTPSCommand": {
        "type": "object", "additionalProperties": false,
        "x-config-key": "throttlerRequestedTps",
        "required": ["action", "value"],
        "properties": {
          "action": { "type": "string", "enum": ["set-requested-tps"] },
          "value": { "type": "integer", "format": "int64", "description": "Allowed values are published in snapshot.config.throttlerRequestedTps." }
        }
      },
      "SenderWorkersCommand": {
        "type": "object", "additionalProperties": false,
        "x-config-key": "senderWorkers",
        "required": ["action", "value"],
        "properties": {
          "action": { "type": "string", "enum": ["set-sender-workers"] },
          "value": { "type": "integer", "format": "int64", "description": "Allowed values are published in snapshot.config.senderWorkers." }
        }
      },
      "InstalledCommand": {
        "type": "object", "additionalProperties": false,
        "required": ["action", "value"],
        "properties": {
          "action": { "type": "string", "enum": ["set-throttler-installed"] },
          "value": { "type": "boolean" }
        }
      },
      "Snapshot": {
        "type": "object", "additionalProperties": false,
        "required": ["run", "reader", "throttler", "sender", "readerChannel", "senderChannel", "config"],
        "properties": {
          "run": { "$ref": "#/components/schemas/RunStatus" },
          "reader": { "$ref": "#/components/schemas/ReaderStatus" },
          "throttler": { "$ref": "#/components/schemas/ThrottlerStatus" },
          "sender": { "$ref": "#/components/schemas/SenderStatus" },
          "readerChannel": { "$ref": "#/components/schemas/ChannelStatus" },
          "senderChannel": { "$ref": "#/components/schemas/ChannelStatus" },
          "config": { "$ref": "#/components/schemas/ConfigStatus" }
        }
      },
      "RunStatus": {
        "type": "object", "additionalProperties": false,
        "required": ["state", "totalTransactions", "elapsedMs"],
        "properties": {
          "state": { "type": "string", "enum": ["starting", "running", "stopping", "faulted"] },
          "totalTransactions": { "type": "integer", "format": "int64" },
          "elapsedMs": { "type": "integer", "format": "int64" }
        }
      },
      "ReaderStatus": {
        "type": "object", "additionalProperties": false,
        "required": ["workers", "liveWorkers", "idleWorkers", "readingWorkers", "blockedWorkers", "drainingWorkers", "drainingIdleWorkers", "drainingReadingWorkers", "drainingBlockedWorkers", "readBatchSize", "readTps", "rowsRead", "sourceDirectory", "sourceError"],
        "properties": {
          "workers": { "type": "integer" }, "liveWorkers": { "type": "integer" }, "idleWorkers": { "type": "integer" }, "readingWorkers": { "type": "integer" }, "blockedWorkers": { "type": "integer" },
          "drainingWorkers": { "type": "integer" }, "drainingIdleWorkers": { "type": "integer" }, "drainingReadingWorkers": { "type": "integer" }, "drainingBlockedWorkers": { "type": "integer" },
          "readBatchSize": { "type": "integer", "minimum": 1, "maximum": 9223372036, "description": "Applied startup batch size; bounded by Go int and safe batch pacing duration arithmetic." }, "readTps": { "type": "number", "format": "double" }, "rowsRead": { "type": "integer", "format": "int64" },
          "sourceDirectory": { "type": "string" }, "sourceError": { "$ref": "#/components/schemas/ReaderSourceError" }
        }
      },
      "ReaderSourceError": {
        "type": "object", "nullable": true, "additionalProperties": false,
        "required": ["category", "operation", "relativePath", "message"],
        "properties": { "category": { "type": "string" }, "operation": { "type": "string" }, "relativePath": { "type": "string" }, "message": { "type": "string" } }
      },
      "ThrottlerStatus": {
        "type": "object", "additionalProperties": false,
        "required": ["requestedTps", "admittedTps", "installed"],
        "properties": { "requestedTps": { "type": "integer" }, "admittedTps": { "type": "number", "format": "double" }, "installed": { "type": "boolean" } }
      },
      "SenderStatus": {
        "type": "object", "additionalProperties": false,
        "required": ["workers", "liveWorkers", "idleWorkers", "inFlightWorkers", "backoffWorkers", "drainingWorkers", "drainingIdleWorkers", "drainingInFlightWorkers", "drainingBackoffWorkers"],
        "properties": {
          "workers": { "type": "integer" }, "liveWorkers": { "type": "integer" }, "idleWorkers": { "type": "integer" }, "inFlightWorkers": { "type": "integer" }, "backoffWorkers": { "type": "integer" },
          "drainingWorkers": { "type": "integer" }, "drainingIdleWorkers": { "type": "integer" }, "drainingInFlightWorkers": { "type": "integer" }, "drainingBackoffWorkers": { "type": "integer" }
        }
      },
      "ChannelStatus": {
        "type": "object", "additionalProperties": false,
        "required": ["capacity", "depthBatches", "bufferedTransactions", "blockedSenders", "oldestBlockedSenderMs", "blockedMs", "inputTransactionsPerSecond", "outputTransactionsPerSecond"],
        "properties": {
          "capacity": { "type": "integer" }, "depthBatches": { "type": "integer" }, "bufferedTransactions": { "type": "integer" }, "blockedSenders": { "type": "integer" }, "oldestBlockedSenderMs": { "type": "integer", "format": "int64" }, "blockedMs": { "type": "integer", "format": "int64" },
          "inputTransactionsPerSecond": { "type": "number", "format": "double" }, "outputTransactionsPerSecond": { "type": "number", "format": "double" }
        }
      },
      "ConfigStatus": {"type": "object", "additionalProperties": false, "required": ["readerWorkers", "senderWorkers", "throttlerRequestedTps"], "properties": {"readerWorkers": {"$ref": "#/components/schemas/WorkersConfig"}, "senderWorkers": {"$ref": "#/components/schemas/WorkersConfig"}, "throttlerRequestedTps": {"$ref": "#/components/schemas/TPSConfig"}}},
      "WorkersConfig": {"type": "object", "additionalProperties": false, "required": ["initial", "max"], "description": "Worker commands accept integers 1..max with step 1. Initial is the configured startup count.", "properties": {"initial": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "max": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}},
      "TPSConfig": {"type": "object", "additionalProperties": false, "required": ["initial", "max", "step"], "description": "TPS commands accept 0..max on the step grid from zero. An off-grid max is a bound, not an allowed command.", "properties": {"initial": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "max": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "step": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}}
    }
  }
}
